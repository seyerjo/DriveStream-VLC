# Optional configuration for drive-vlc
# Copy this file to ~/.config/drive-vlc/.env or to .env at the repository root.

# Optional: Google Drive API v3 key (useful as a fallback for large public files)
# GOOGLE_DRIVE_API_KEY=

# VLC network caching in milliseconds for streaming playback (default: 3000)
# DRIVE_VLC_CACHE_MS=3000

# Path to the VLC executable (optional; auto-detected via PATH or /usr/bin/vlc)
# DRIVE_VLC_BIN=/usr/bin/vlc

# Path to the yt-dlp executable (optional; auto-detected via PATH or ~/.local/bin/yt-dlp)
# DRIVE_VLC_YT_DLP_BIN=~/.local/bin/yt-dlp
